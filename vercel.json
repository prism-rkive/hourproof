{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'static site: nothing to install'",
  "buildCommand": "bash scripts/build_site.sh",
  "outputDirectory": "site",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/overview", "destination": "/api/overview.json" },
    { "source": "/api/week", "destination": "/api/week.json" },
    { "source": "/api/carbon", "destination": "/api/carbon.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
