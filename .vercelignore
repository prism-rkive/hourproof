# Allow-list: Vercel only needs the dashboard sources, the committed snapshot, the build script and the build config.
# Everything else (Python sources, data, .env, keys, evidence, caches, local installs and builds) is never uploaded.
/*
!/frontend
/frontend/node_modules
/frontend/dist
/frontend/e2e/screenshots
/frontend/test-results
/frontend/playwright-report
!/deploy
!/scripts
/scripts/*
!/scripts/build_site.sh
!/vercel.json
!/package.json
