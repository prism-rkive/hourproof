{
  "name": "HourProof",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "postCreateCommand": "./scripts/install_tools.sh && python -m venv .venv && .venv/bin/pip install -r requirements.txt && echo 'export PATH=$PWD/.venv/bin:$HOME/.hourproof/bin:$PATH' >> ~/.bashrc",
  "forwardPorts": [8000],
  "customizations": { "vscode": { "extensions": ["ms-python.python", "NomicFoundation.hardhat-solidity", "noir-lang.vscode-noir"] } }
}
